{
  "layer": "top",
  "fixed-center": false,
  "modules-left": [
    "sway/workspaces"
  ],
  "modules-right": [
    "tray",
    "memory",
    "bluetooth",
    "wireplumber",
    "wireplumber#microphone",
    "battery",
    "clock",
    "group/power"
  ],
  "margin-top": 5,
  "margin-left": 5,
  "margin-right": 5,
  "height": 20,
  "tray": {
    "icon-size": 20,
    "spacing": 10
  },
  "clock": {
    "format": "  {:%H:%M}"
  },
  "battery": {
    "format": "󰁺 {capacity}%"
  },
  "wireplumber": {
    "format": "   {volume}%",
    "format-muted": "   {volume}%",
    "on-click": "kitty wiremix",
    "reverse-scrolling": true,
    "reverse-mouse-scrolling": true
  },
  "wireplumber#microphone": {
    "node-type": "Audio/Source",
    "format": "󰍬 {volume}%",
    "format-muted": "󰍭 {volume}%",
    "on-click": "wpctl set-mute @DEFAULT_SOURCE@ toggle",
    "reverse-scrolling": true,
    "reverse-mouse-scrolling": true,
    "max-volume": 150
  },
  "bluetooth": {
    "format": "󰂯",
    "format-connected": "󰂯 {num_connections}",
    "tooltip-format": "{device_alias}",
    "on-click": "kitty bluetui"
  },
  "memory": {
    "format": "   {used:0.1f}GiB/{total:0.0f}GiB"
  },
  "group/power": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 500,
      "transition-left-to-right": false
    },
    "modules": [
      "custom/lock",
      "custom/suspend"
    ]
  },
  "custom/lock": {
    "format": "",
    "tooltip": false,
    "on-click": "swaymsg exec swaylock"
  },
  "custom/suspend": {
    "format": " 󰒲 ",
    "tooltip": false,
    "on-click": "systemctl suspend"
  }
}
