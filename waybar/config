{
  "layer": "top",
  "modules-left": [
    "sway/workspaces"
  ],
  "modules-center": [
    "custom/music"
  ],
  "modules-right": [
    "tray",
    "memory",
    "wireplumber",
    "battery",
    "clock"
  ],
  "margin-top": 5,
  "margin-left": 5,
  "margin-right": 5,
  "height": 20,
  "tray": {
    "icon-size": 20,
    "spacing": 10
  },
  "clock": {
    "format": "  {:%H:%M}"
  },
  "battery": {
    "format": "󰁺 {capacity}%"
  },
  "wireplumber": {
    "format": "   {volume}%",
    "format-muted": "   {volume}%",
    "on-click": "kitty wiremix"
  },
  "memory": {
    "format": "   {used:0.1f}GiB/{total:0.0f}GiB"
  },
  "custom/music": {
    "exec": "playerctl -f \"{{title}} - {{artist}}\" --follow metadata",
    "format": "󰲹  {}",
    "max-length": 50,
    "on-click": "playerctl play-pause"
  }
}
